# Copy to `.env.local` in this directory (Vite reads the project root, not
# `frontend/`) and fill in from the Firebase console. `.env.local` is gitignored.
#
# Firebase web config is public by design — the API key identifies the project,
# it does not grant access. Access is enforced by backend role checks and
# Firestore rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Run service URL, no trailing slash. Local FastAPI default shown.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend (not read by Vite). Set these in the Cloud Run service, not here.
# ---------------------------------------------------------------------------
# GCP_PROJECT_ID=vertical-theory-383513
# GCP_LOCATION=us-central1
# ALLOWED_ORIGINS=https://your-frontend-host
# GEMINI_API_KEY=            # omit to use Vertex AI with ADC instead

# Frontend demo mode.
# true = teacher dashboard can be viewed without Firebase login.
# false = normal Firebase authentication is required.
VITE_DEMO_MODE=false
